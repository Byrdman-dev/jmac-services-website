---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CallCta from '../components/CallCta.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

const title = `About | ${site.shortName}`;
const description = `${site.intro} ${site.audience} work across ${site.area}.`;
---

<BaseLayout title={title} description={description}>
  <Header currentPage="about" />
  <main>
    <section class="bg-ink">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-6 pb-20 pt-[72px]">
        <p class="text-[15px] font-semibold uppercase tracking-[0.16em] text-safety">About us</p>
        <h1 class="font-display text-[clamp(44px,7vw,72px)] font-extrabold uppercase leading-[0.96]">
          {site.headline}
        </h1>
        <p class="max-w-[640px] text-xl leading-relaxed text-mute">{site.intro}</p>
        <p class="text-base font-semibold uppercase tracking-widest text-paper">
          {site.audience} · Serving {site.area}
        </p>
      </div>
    </section>

    <section class="bg-paper text-ink-soft">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 py-24">
        <SectionHeading eyebrow="What we stand for" title="Built on integrity." tone="light" />
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {
            site.values.map((value) => (
              <li class="rounded-md border border-card-line bg-white px-7 py-8 text-center">
                <p class="font-display text-[22px] font-bold uppercase text-ink-soft">{value}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bg-ink-soft">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-center gap-x-8 gap-y-3.5 px-6 py-[26px]">
        {
          site.tagline.map((line) => (
            <p class="font-display text-[26px] font-bold uppercase italic tracking-[0.06em] text-paper">{line}</p>
          ))
        }
      </div>
    </section>

    <CallCta />
  </main>
  <Footer />
</BaseLayout>
