---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TaglineBand from '../components/TaglineBand.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Work from '../components/Work.astro';
import CallCta from '../components/CallCta.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

const title = 'JMAC Services | Land Clearing, Dirt Work & Gravel Driveways in Southwest Louisiana';
const description = `Residential and commercial land clearing, brush hogging, dirt work, gravel driveways, debris removal and skid steer work in ${site.area}. Call ${site.phone.display}.`;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <TaglineBand />
    <Services />
    <Process />
    <Work />
    <CallCta />
  </main>
  <Footer />
</BaseLayout>
