---
import { site } from '../config/site';
---

<section id="quote" class="bg-ink">
  <div class="mx-auto flex max-w-[880px] flex-col items-center gap-7 px-6 py-[104px] text-center">
    <p class="text-[15px] font-semibold uppercase tracking-[0.16em] text-safety">Get a quote</p>
    <h2 class="font-display text-[clamp(40px,7vw,64px)] font-extrabold uppercase leading-none">
      Call us about your job.
    </h2>
    <p class="max-w-[560px] text-xl leading-relaxed text-mute">
      {site.audience.replace('&', 'and').toLowerCase()} work across {site.area}. Tell us what you need and we'll take
      it from there.
    </p>
    <a
      href={site.phone.href}
      class="mt-2 inline-flex min-h-[76px] items-center justify-center gap-4 rounded-md bg-safety px-8 text-ink hover:opacity-90 sm:px-12"
    >
      <svg viewBox="0 0 24 24" class="size-8 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"></path>
      </svg>
      <span class="font-display text-[clamp(28px,5vw,40px)] font-extrabold tracking-[0.02em]">
        Call {site.phone.display}
      </span>
    </a>
    <ul class="flex flex-wrap justify-center gap-x-7 gap-y-3 pt-6 text-sm font-semibold uppercase tracking-[0.14em] text-mute-dim">
      {site.values.map((value) => <li>{value}</li>)}
    </ul>
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-lg font-medium">
      <a href={`mailto:${site.email}`} class="hover:opacity-90">{site.email}</a>
      <a href={site.facebook} class="hover:opacity-90" rel="noopener">{site.shortName} on Facebook</a>
    </div>
  </div>
</section>
