---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { site } from '../config/site';
---

<section id="work" class="bg-paper text-ink-soft">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-12 px-6 py-24">
    <SectionHeading eyebrow="Our work" title="See the difference." tone="light" />
    <ul class="flex flex-wrap justify-center gap-12">
      {
        site.work.map((item) => (
          <li>
            {item.facebookReel ? (
              <a
                href={item.facebookReel}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative block"
                aria-label={`Watch the ${item.label} reel on Facebook`}
              >
                <Image
                  src={item.photo}
                  alt={item.label}
                  width={220}
                  height={390}
                  class="h-[390px] w-[220px] rounded-md border border-[#d3cec2] object-cover transition-opacity group-hover:opacity-80"
                />
                <span class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-md bg-black/10 transition-colors group-hover:bg-black/25">
                  <span class="flex h-14 w-14 items-center justify-center rounded-full bg-safety shadow-md transition-transform group-hover:scale-110">
                    <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 fill-ink">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </span>
                <p class="mt-2 text-center text-[15px] font-semibold uppercase tracking-[0.08em] text-[#4a505a]">
                  {item.label}
                </p>
              </a>
            ) : (
              <>
                <Image
                  src={item.photo}
                  alt={item.label}
                  width={220}
                  height={390}
                  class="h-[390px] w-[220px] rounded-md border border-[#d3cec2] object-cover"
                />
                <p class="mt-2 text-center text-[15px] font-semibold uppercase tracking-[0.08em] text-[#4a505a]">
                  {item.label}
                </p>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
