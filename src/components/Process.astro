---
import SectionHeading from './SectionHeading.astro';
import { site } from '../config/site';
---

<section id="process" class="bg-ink-soft">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-14 px-6 py-24">
    <SectionHeading eyebrow="Getting started" title="Three steps. No runaround." tone="dark" />
    <ol class="grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-10">
      {
        site.steps.map((step, i) => (
          <li class="flex flex-col gap-3 border-t-2 border-brand-bright pt-6">
            <span class="font-display text-[72px] font-extrabold leading-none text-safety" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display text-[30px] font-bold uppercase text-paper">{step.title}</h3>
            <p class="text-[17px] leading-relaxed text-mute">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
